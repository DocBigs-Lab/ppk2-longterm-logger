# Kopieren nach .env und anpassen:  cp .env.example .env

# --- Messung ---
# source = PPK2 versorgt das Testobjekt, ampere = nur Strommessung (externe Versorgung)
PPK2_MODE=source
# Spannung in mV: im Source-Modus die Versorgung des Prüflings, im Ampere-Modus der Wert für die Berechnung
PPK2_VOLTAGE_MV=3300
# Leer lassen = PPK2 automatisch suchen, sonst z. B. /dev/ttyACM0
PPK2_PORT=

# --- Akku (für die Laufzeitschätzung) ---
BATTERY_MAH=3000
# Nutzbarer Anteil der Kapazität (0.8 = 80 %)
BATTERY_USABLE=0.8

# --- Logging ---
# Intervall in Sekunden für Mittel/Min/Max (höher = weniger Last in HA)
LOG_INTERVAL_S=1
OUT_DIR=/data

# --- MQTT / Home Assistant (optional, leer lassen = aus) ---
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_TOPIC=ppk2/stats

# --- Ruhestrom-Sensor (nur MQTT/Home Assistant, nicht in der CSV) ---
# Fensterbreite des gleitenden Mittelwerts in Sekunden (300 = 5 Minuten).
# Größer = ruhiger, aber träger; kleiner = schneller, aber unruhiger.
ROLL_WINDOW_S=300
# Schwelle in uA: Intervalle mit Mittelwert darüber gelten als "aktiv"
# (WLAN, Display-Refresh) und zählen nicht zum Ruhestrom. 5000 = 5 mA.
QUIET_MAX_UA=5000

# --- Wachphasen in voller Auflösung speichern (100 kSps) ---
# 1 = an. Jede Wachphase landet als .npz unter data/wake/JJJJ-MM-TT/,
# dazu eine Zeile in data/wake/wake_index.csv. Ca. 3 MB pro 30-s-Wachphase (gemessen).
WAKE_CAPTURE=0
# Schwelle in uA für das gleitende Mittel. Leer = QUIET_MAX_UA.
WAKE_TRIGGER_UA=
# Fenster des gleitenden Mittels in ms. 100 ms ignoriert kurze Pulse im Ruhestrom
# (Wandler im Pulsbetrieb erreichen im 1-ms-Mittel bis ca. 30 mA).
WAKE_TRIGGER_MS=100
# Vorlauf und Nachlauf in Sekunden. Der Nachlauf ist auch die Zeit unter der Schwelle,
# nach der eine Wachphase als beendet gilt (kurze Einbrüche beenden sie nicht).
WAKE_PRE_S=2
WAKE_POST_S=2
# Höchstdauer einer Aufnahme in Sekunden (z. B. bei Dauerstrom durch Laden)
WAKE_MAX_S=120
# Obergrenze für den Ordner data/wake in MB, älteste Dateien werden gelöscht
WAKE_MAX_MB=2000
# Unter diesem freien Platz in MB wird nicht mehr gespeichert
WAKE_MIN_FREE_MB=500

# --- Live-Ansicht im Browser ---
# Port des Webservers im Container, leer = aus. Zusätzlich in docker-compose.yml
# den Abschnitt "ports" einkommentieren. Nur fürs Heimnetz: keine Anmeldung.
LIVE_PORT=
# So viele Sekunden hält der Logger für die Ansicht vor (1-ms-Auflösung, ca. 1,4 MB Speicher bei 120 s)
LIVE_HISTORY_S=120
